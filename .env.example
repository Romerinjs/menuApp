# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudflare R2 / S3 Storage Configuration
VITE_R2_ACCOUNT_ID=your_account_id
VITE_R2_ACCESS_KEY_ID=your_access_key_id
VITE_R2_SECRET_ACCESS_KEY=your_secret_access_key
VITE_R2_BUCKET_NAME=menuapp
VITE_R2_PUBLIC_URL=https://pub-your_id.r2.dev
VITE_S3_API_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com/menuapp

# Google Gemini AI Key
GEMINI_API_KEY=tu_api_key_aqui
